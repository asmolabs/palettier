<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Le reseau ne sert qu'a l'assistant, et seulement si le peintre en configure un.
      Tout le reste - catalogue, projets, melanges, sechage - travaille hors ligne.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PalettierApplication"
        android:label="Palettier"
        android:supportsRtl="true"
        android:theme="@style/Theme.Palettier">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Palettier"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
