CREATE TABLE palette (
    id      INTEGER PRIMARY KEY AUTOINCREMENT,
    name    TEXT NOT NULL,
    purpose TEXT NOT NULL DEFAULT '',
    notes   TEXT NOT NULL DEFAULT ''
);

CREATE UNIQUE INDEX palette_name ON palette(name);

CREATE TABLE palette_paint (
    palette_id INTEGER NOT NULL REFERENCES palette(id) ON DELETE CASCADE,
    paint_id   INTEGER NOT NULL REFERENCES paint(id) ON DELETE CASCADE,
    position   INTEGER NOT NULL,
    PRIMARY KEY (palette_id, paint_id)
);

selectAll:
SELECT * FROM palette ORDER BY name;

selectById:
SELECT * FROM palette WHERE id = ?;

paintsOf:
SELECT paint_id FROM palette_paint WHERE palette_id = ? ORDER BY position;

allPaints:
SELECT palette_id, paint_id FROM palette_paint ORDER BY palette_id, position;

insert:
INSERT INTO palette(name, purpose, notes) VALUES (?, ?, ?);

update:
UPDATE palette SET name = ?, purpose = ?, notes = ? WHERE id = ?;

clearPaints:
DELETE FROM palette_paint WHERE palette_id = ?;

addPaint:
INSERT INTO palette_paint(palette_id, paint_id, position) VALUES (?, ?, ?);

delete:
DELETE FROM palette WHERE id = ?;

lastInsertedId:
SELECT last_insert_rowid();
